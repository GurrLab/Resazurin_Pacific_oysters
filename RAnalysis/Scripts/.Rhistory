df_binary_1wk
df_binary_1wk <- df_binary_1wk %>% na.omit()
# Convert to Date class
dates_asDate <- as.Date(df_binary_1wk$Date, format = "%Y%m%d")
# Find earliest date
earliest <- min(dates_asDate)
# Calculate number of days since earliest date
days_since_earliest <- as.numeric(dates_asDate - earliest)
#
df_binary_1wk$Days <- as.numeric(days_since_earliest)
Count_tally <- df_binary_1wk %>%
dplyr::group_by(Days, Treatment, Tank_number)  %>%
dplyr::summarise(
n_0 = sum(Count_dead == 0, na.rm = TRUE),
n_1 = sum(Count_dead == 1, na.rm = TRUE),
n_total = n(),
.groups = "drop"
)
Count_tally
MeanSE_Count_alive <- Rmisc::summarySE(data = df_KM_1wk,
measurevar = 'Count_Alive',
groupvars = c('Date', 'Treatment', 'Prime_treatment')) %>% dplyr::select(!c(sd, se, ci))
MeanSE_Count_dead  <- Rmisc::summarySE(data = df_KM_1wk,
measurevar = 'Count_Dead',
groupvars = c('Date', 'Treatment', 'Prime_treatment')) %>% dplyr::select(!c(sd, se, ci))
Mean_count_alive_dead <- merge(MeanSE_Count_alive, MeanSE_Count_dead)
MeanSE_Count_alive
surv_1wk <- survfit2(Surv(Days, Count_dead) ~ Treatment, data = (df_binary_1wk %>% dplyr::filter(!Days>4)))
surv_1wk
km_fit <- survfit2(Surv(Days, Count_dead) ~ Treatment, data = (df_binary_1wk %>% dplyr::filter(!Days>4)))
ggsurvplot(
km_fit,
data = (df_binary_1wk %>% dplyr::filter(!Days>4)),
risk.table = TRUE,
pval = TRUE,
conf.int = TRUE
)
ggsurvplot(
km_fit,
data = (df_binary_1wk %>% dplyr::filter(!Days>4)),
risk.table = TRUE,
conf.int = TRUE,
xlab = "Time",
ylab = "Survival probability",
surv.median.line = "hv"
)
